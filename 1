/* #543b37 #db9c85 #e56d84 #e73b68 #feebed */

body {
background-color: #DB9C85;
color: #543b37;
font-family: 'Merienda', cursive;
}

header {
width: auto;
max-width: 20%;
background-color: #DB9C85;
}

#logo {
display: flex;
justify-content: center;
align-items: center;
min-height: 100px; /* Ensures it doesn’t shrink too much */
padding: 10px;
}

nav {
width: 100%;
background-color: #DB9C85;
display: flex;
justify-content: center;
align-items: center;
padding: 1em 0;
box-sizing: border-box;
}

nav ul {
list-style-type: none;
margin: 0;
padding: 0;
display: flex;
justify-content: center;
width: 100%;
flex-wrap: wrap;
}

nav li {
font-size: 1.5em;
}

nav li a {
display: block;
color: black;
text-align: center;
padding: 0.5em 1em;
text-decoration: none;
transition: color 0.3s ease, background-color 0.3s ease;
}

#bio{
text-align: center;
padding: 5%;
background-color: #FEEBED;
max-width: 800px;
margin: 0 auto 18px auto;
}

#bio input[type="email"] {
width: 70%;
padding: 0.5em;
font-size: 1em;
margin-top: 10px;
border: 2px solid #E56D84;
border-radius: 5px;
outline: none;
box-sizing: border-box;
}

#bio input[type="email"]:focus {
border-color: #E73B68;
box-shadow: 0 0 5px rgba(231, 59, 104, 0.5);
}

#bio button {
padding: 0.6em 1.2em;
font-size: 1em;
background-color: #E73B68;
color: white;
border: none;
border-radius: 5px;
cursor: pointer;
margin-top: 10px;
transition: background-color 0.3s ease;
}

#bio button:hover {
background-color: #E56D84;
}

#bio button:focus {
outline: none;
box-shadow: 0 0 5px rgba(231, 59, 104, 0.5);
}

img {
max-width: 100%;
display: block;
}

main{
clear: left;
background-color: #FEEBED;
padding: 2%;
margin: 0 2%;
}

footer {
display: flex;
justify-content: space-around;
flex-wrap: wrap;
text-decoration: none;
}

footer a, #contact a {
color: #543B37;
text-decoration: none;
}

footer a:hover, #contact a:hover {
color: #E73B68;
text-decoration: underline;
}

footer a:visited, #contact a:visited {
color: #FEEBED;
}

footer a:active, #contact a:active {
color: #E56D84;
}